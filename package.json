{
  "name": "ni-future",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/*.test.mjs",
    "test:integration": "npm run build && PATH=/usr/local/opt/openjdk@21/bin:$PATH npx firebase-tools@15.32.1 emulators:exec --only firestore --project ni-future-local-test 'node --test tests/integration/*.test.mjs'",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "firebase-admin": "^14.5.0",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
